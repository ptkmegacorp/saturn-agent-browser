# Saturn frontier browser control — Chromium tenant (this project only).
# Source from every launch script. Do not override to a shared cache or daily profile.

SATURN_FBC_NAME=SaturnFrontierBrowser
SATURN_FBC_SHARE="${HOME}/.local/share/saturn-frontier-browser-control"
SATURN_FBC_CHROMIUM_USER_DATA="${SATURN_FBC_SHARE}/chromium"
PLAYWRIGHT_BROWSERS_PATH="${SATURN_FBC_SHARE}/playwright-browsers"
