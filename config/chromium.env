# Saturn Agent Browser — Chromium tenant (this project only).
# Source from every launch script. Do not override to a shared cache or daily profile.

SATURN_AGENT_BROWSER_NAME=SaturnAgentBrowser
SATURN_AGENT_BROWSER_SHARE="${HOME}/.local/share/saturn-agent-browser"
SATURN_AGENT_BROWSER_CHROMIUM_USER_DATA="${SATURN_AGENT_BROWSER_SHARE}/chromium"
PLAYWRIGHT_BROWSERS_PATH="${SATURN_AGENT_BROWSER_SHARE}/playwright-browsers"
