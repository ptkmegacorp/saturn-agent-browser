# This project is a GPU tenant. It does not share the live HUD model.
# saturn-frontier-browser-control run: overlay hide, then pig-stack switch
# On done/abort: leave pig-stack on this profile (no auto-restore).

PIG_STACK_PROFILE=saturn-frontier-browser-control
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8091
PIG_MODEL_ID=ui-venus-2-9b-q4km-local
HUD_DURING_RUN=disable
