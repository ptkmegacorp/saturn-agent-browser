# Dedicated trusted Chrome lane. Isolated Playwright Chromium stays
# on SATURN_FBC_CHROMIUM_USER_DATA / :9222. Pi snapshots use :9223.

SATURN_FBC_TRUSTED_NAME=SaturnTrustedChrome
SATURN_FBC_TRUSTED_PROFILE="${SATURN_FBC_SHARE}/trusted-chrome"
SATURN_FBC_TRUSTED_STATE="${SATURN_FBC_SHARE}/trusted-browser-state.json"
SATURN_FBC_TRUSTED_CDP_PORT=9223
# SATURN_FBC_TRUSTED_EXECUTABLE=/usr/bin/google-chrome-stable
