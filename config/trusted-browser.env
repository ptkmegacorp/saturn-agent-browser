# Dedicated trusted Chrome lane. Isolated Playwright Chromium stays
# on SATURN_AGENT_BROWSER_CHROMIUM_USER_DATA / :9222. Pi snapshots use :9223.

SATURN_AGENT_BROWSER_TRUSTED_NAME=SaturnTrustedChrome
SATURN_AGENT_BROWSER_TRUSTED_PROFILE="${SATURN_AGENT_BROWSER_SHARE}/trusted-chrome"
SATURN_AGENT_BROWSER_TRUSTED_STATE="${SATURN_AGENT_BROWSER_SHARE}/trusted-browser-state.json"
SATURN_AGENT_BROWSER_TRUSTED_CDP_PORT=9223
# SATURN_AGENT_BROWSER_TRUSTED_EXECUTABLE=/usr/bin/google-chrome-stable
