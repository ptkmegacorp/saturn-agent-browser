# Saturn HDMI defaults — headed browser on :0 unless overridden.
# Opt out: SATURN_FBC_HEADLESS=1 or pass --headless on the CLI.

SATURN_FBC_HEADLESS=0
DISPLAY=:0
XAUTHORITY=~/.Xauthority
# Persistent daemon attaches over CDP; ephemeral runs use launch-close path.
SATURN_FBC_BROWSER_MODE=daemon
SATURN_FBC_CDP_PORT=9222
# No hold delay when attached to daemon (Phase B); 0 for daemon mode default.
SATURN_FBC_HOLD_SECONDS=0
