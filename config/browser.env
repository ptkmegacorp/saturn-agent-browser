# Saturn HDMI defaults — headed browser on :0 unless overridden.
# Opt out: SATURN_AGENT_BROWSER_HEADLESS=1 or pass --headless on the CLI.

SATURN_AGENT_BROWSER_HEADLESS=0
DISPLAY=:0
# Set for your X session, e.g. XAUTHORITY=$HOME/.Xauthority
# Persistent daemon attaches over CDP; ephemeral runs use launch-close path.
SATURN_AGENT_BROWSER_BROWSER_MODE=daemon
SATURN_AGENT_BROWSER_CDP_PORT=9222
# No hold delay when attached to daemon (Phase B); 0 for daemon mode default.
SATURN_AGENT_BROWSER_HOLD_SECONDS=0
