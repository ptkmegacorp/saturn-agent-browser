# How secrets reach the page. Broker is V1 default; KeePassXC-Browser remains available.
# broker              — privileged process fills via Playwright; secret never leaves broker
# keepassxc-browser   — extension in this Chromium profile only
CREDENTIAL_FILL=broker
# Optional overrides (defaults: ~/keepass/Agent.kdbx and ~/.config/saturn-agent-browser/agent-vault.key)
