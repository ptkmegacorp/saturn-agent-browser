[Unit]
Description=Saturn Frontier Browser (persistent Chromium on HDMI)
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=~/projects/saturn-agent-browser
ExecStart=~/projects/saturn-agent-browser/scripts/browser-daemon.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
KillMode=mixed
UMask=0077

[Install]
WantedBy=default.target
